<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and below. Favourites and visits live in the Room
   database, so it is backed up together with the small UI preference files. Anything in
   the cache directories (image cache) is excluded by default.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="foodie_prefs.xml" />
    <include domain="sharedpref" path="foodie_ui_state.xml" />
</full-backup-content>
