<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12+. Favourites and visits live in the Room
   database, so it is included together with the small UI preference files. The image cache
   is not backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="foodie_prefs.xml" />
        <include domain="sharedpref" path="foodie_ui_state.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="foodie_prefs.xml" />
        <include domain="sharedpref" path="foodie_ui_state.xml" />
    </device-transfer>
</data-extraction-rules>
